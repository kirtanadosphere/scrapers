{
  "name": "standalone-social-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts --host 127.0.0.1 --port 4983",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/lib-storage": "^3.1004.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "axios": "^1.15.2",
    "bullmq": "^5.70.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "ioredis": "^5.9.3",
    "nanoid": "^5.1.5",
    "pg": "^8.20.0",
    "ytdlp-nodejs": "^3.4.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
